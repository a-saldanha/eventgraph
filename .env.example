# Copy to .env. Loaded via `uvicorn app.api:app --env-file .env`.
# With no key set, the pipeline runs in mock/heuristic mode (no LLM calls).

# LLM provider: "anthropic" or "mock"
LLM_PROVIDER=anthropic

# Extraction model (cheaper; batched + cached). Switch to claude-haiku-4-5 for large new datasets.
LLM_MODEL=claude-sonnet-4-6

# Smart model used to answer natural-language questions (/api/ask).
LLM_QUERY_MODEL=claude-opus-4-8

# Keys. If unset, they are read from ../backend/.env (legacy fallback) when present.
LLM_API_KEY=sk-ant-...
# LLAMA_CLOUD_API_KEY=llx-...   # only needed to ingest raw PDFs via LlamaParse
