# Copy to .env. Loaded automatically when uvicorn is started with --env-file .env.
# With no key set the pipeline runs in heuristic mode (no LLM calls).

# LLM provider: "anthropic" or "mock"
LLM_PROVIDER=anthropic

# Model used for entity extraction (batched + cached — uses cheaper model by default).
LLM_EXTRACT_MODEL=claude-haiku-4-5

# Model used for entity resolution.
LLM_RESOLVE_MODEL=claude-sonnet-4-6

# Model used for natural-language /api/ask queries.
LLM_QUERY_MODEL=claude-sonnet-4-6

# Anthropic API key.
LLM_API_KEY=sk-ant-...
# LLAMA_CLOUD_API_KEY=llx-...   # only needed to ingest raw PDFs via LlamaParse

# Required in production — every /api/* route (except /api/health) requires
# "Authorization: Bearer <value>". Leave unset for local dev.
BACKEND_TOKEN=

# Directory containing bundle.json (production: mount a Railway volume here).
# Defaults to ./data/ when unset.
DATA_DIR=

# Set to 1 to protect the shared bundle from visitor writes.
DEMO_READONLY=1

# Comma-separated allowed CORS origins. Leave empty in production (same-origin proxy).
# Example for local dev: CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=

# ── Frontend (Vercel) ──────────────────────────────────────────────────────────

# Site-wide password. Anyone with it can see the full archive.
# Leave unset for local dev — the password gate is disabled when this is not set.
SITE_PASSWORD=

# 32+ random characters used to sign the session cookie.
# Generate: openssl rand -hex 32
SITE_SECRET=

# Bump this integer to immediately log out all active sessions.
SITE_PASSWORD_VERSION=1
